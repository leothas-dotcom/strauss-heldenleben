// G, suo aamupäivän sameudessa ja illassa: näytös 2, vastustajat (wid_1_huilu ... gef_viulu).
// Ohjaus: docs/ohjaus.md luku 2. Kaikki ajat ovat ankkureita (S.A), jaksorajoja (S.segs) tai mitattuja
// kanavia (S.fam, S.energy, S.onsetsIn); hahmon eleiden kestot ovat osuuksia kahden ankkurin välistä (fr()).
//   2.1 Pisto: ritari laskeutuu suolle, istuu harppupuun juurelle; hyttynen (huilu) pistää, hän huitaisee keihäällä.
//   2.2 Olennot yksi kerrallaan omilla ankkureillaan, ritari reagoi jokaiseen eri tavalla:
//       sorsa (oboe): selkä sorsalle; haikara (englannintorvi): nousee puoliksi; kotilot (Dehring): käsi korvalle;
//       peili (englannintorvi + fagotit): katsoo laihaa Quijotea; varikset (pasuunat): viiri suojaan.
//   2.3 Kuoro: sameus sakenee, hän yrittää nousta mutta painuu takaisin.  2.4 Molli: kypärä alas, keihäs maahan.
//   2.5 Muisto: polvistuu lammen ääreen; aamun harjanne (loc_valley.js:n profiili) nousee veden alle kolmessa aallossa
//       (jaksorajat), kolmannella hän tarttuu viiriin.  2.6 Piiritys: nousee seisomaan, selkä puuhun.
//   2.7 Toverit harjanteella vastaavat, roiske (lautaset).  2.8 Viiri pystyyn, leveä veto suon yli, olennot tippoina.

import * as THREE from 'three';
import { C, ink, flat, group, poly, rect, circle, deadTree, skylineGeo, strokeGeo, water, sky as makeSky, ridgePts, clamp, smoothstep, mix, hash1, vnoise1 } from './paper.js';
import { knight, poseKnight, KP, kmix, POSES } from './puppets.js';
import { fluteMosquito, oboeDuck, cAnglaisHeron, tubaSnail, bassoonFrog, tromboneCrow } from './critters.js';
import { common } from './world.js';
import { brushStroke, splat } from './brush.js';
import { leader, camPath, ease } from './hero.js';

// Aamun harjanne (loc_valley.js: topPts): tasanne x -13..15 ja loivat rinteet. Sama kaava, jotta lammen muisto on sama harjanne.
const valleyRidge = (x) => {
  const plateau = 1 - smoothstep(14, 26, Math.abs(x - 1));
  return plateau * (0.12 * (vnoise1(x * 0.8, 5) - 0.5)) + (1 - plateau) * (-0.32 * Math.max(0, Math.abs(x - 1) - 14) + 3.5 * (vnoise1(x / 9, 9) - 0.5));
};

export function build(K) {
  const { S } = K;
  const A = K.a;
  const at = (id) => S.A(id);
  const tMos = at('wid_1_huilu').t, tDuck = at('wid_2_oboe').t, tQ = at('wid_3_4').t, tToad = at('wid_dehring1').t;
  const tCrick = at('wid_6').t, tMock = at('wid_7_8').t, tCrow = at('wid_9_pasuunat').t;
  const tChor = at('wid_kuoro').t, tAns = at('wid_sankari_molli').t, tR16 = at('wid_reh16').t;
  const tNight = at('wid_reh17').t, tRet = at('wid_uusi_hyokkays').t, tR20 = at('wid_reh20').t, tSplash2 = at('wid_reh20_lautaset').t;
  const tSnap = at('wid_sankari_nousee').t, tVoit = at('wid_voitto').t, END = at('gef_viulu').t;
  const fr = (a, b, x) => a + (b - a) * x;   // osuus kahden ankkurin välistä
  const ramp = (a, b, t) => ease(smoothstep(a, b, t));
  const bump = (a, m, b, t) => ramp(a, m, t) * (1 - ramp(m, b, t));

  // muiston kolme aaltoa = jousten crescendo-jaksorajat ankkureiden wid_reh17 ja wid_uusi_hyokkays välissä (segments.json)
  const cres = S.segs.filter((s) => s.a > tNight + 1 && s.a < tRet - 1 && s.suunta === 'crescendo').map((s) => s.a);
  if (cres.length < 2) throw new Error('muiston aallot: jaksorajoja puuttuu wid_reh17 .. wid_uusi_hyokkays');
  const W1 = tNight, W2 = cres[0], W3 = cres[1];
  const bnd = S.segs.map((s) => s.a).filter((a) => a > W3 + 1 && a < tRet - 1);
  if (!bnd.length) throw new Error('muiston häipyminen: jaksoraja puuttuu');
  const FADE = bnd[bnd.length - 1];

  const scene = new THREE.Scene();
  const SKY = makeSky(scene);
  // --- maisema ---
  const horizonPts = [];
  for (let i = 0; i <= 300; i++) { const x = -300 + i * 2; horizonPts.push([x, 1.5 + 1.2 * Math.pow(vnoise1(x * 0.7, 3), 3) + 0.6 * vnoise1(x / 9, 4)]); }
  flat(scene, skylineGeo(horizonPts, -80), ink(C.black, { shade: C.blue, raster: 0.25 }), { z: -120 });
  for (let k = 0; k < 12; k++) flat(scene, deadTree(k * 7 + 3, 2.2 + hash1(k) * 1.4), ink(C.black, { shade: C.blue, raster: 0.4 }), { x: -40 + k * 7.5 + 3 * hash1(k + 1), y: -1, z: -26 - 10 * hash1(k + 2) });
  const PZ = -4;
  const pond = water(scene, 90, 14, { x: 8, y: -6.75, z: PZ, base: C.blue, deep: C.black, glint: 0.55 });
  flat(scene, poly([[-60, 0.25], [60, 0.25], [60, 0.9], [20, 0.75], [8, 0.95], [-4, 0.7], [-60, 0.85]]), ink(C.black, { shade: C.blue, raster: 0.2 }), { z: PZ - 0.2 });
  // lähirannan reuna: tasainen penger x < -0.3, jyrkkä lasku veteen (olennot ja ritari ovat saman kuvan sisällä)
  flat(scene, poly([[-60, -14], [-60, 0], [-0.3, 0.05], [0.1, -0.9], [0.8, -2.8], [1.6, -4.6], [60, -4.6], [60, -14]]), ink(C.black, { grad: [C.blue, -0.4, -3.6, 0.9] }), { z: 0 });
  // haikaran portaat (kromaattinen nousu): neljä paalua, joista jokainen on edellistä korkeampi
  const woodMat = ink(C.black, { shade: C.blue, raster: 0.3 });
  const POSTS = [[3.9, -2.3], [4.45, -1.85], [5.0, -1.4], [5.55, -0.95]];
  for (const [px, py] of POSTS) flat(scene, poly([[-0.12, -4.6], [-0.1, py], [0.1, py], [0.12, -4.6]]), woodMat, { x: px, y: 0, z: PZ + 0.1 });
  // sammakoiden tukki penkereellä
  flat(scene, poly([[-3.7, -0.1], [-3.7, 0.2], [-1.9, 0.12], [-1.9, -0.1]]), woodMat, { z: 0.03 });
  const reedMat = ink(C.black);
  const reed = (x, y0, h, lean, z) => flat(scene, poly([[x - 0.05, y0], [x + 0.05, y0], [x + lean + 0.01, y0 + h], [x + lean - 0.01, y0 + h]]), reedMat, { z });
  for (let k = 0; k < 26; k++) reed(8.2 + k * 0.22 + 0.1 * hash1(k), 0, 1.6 + 1.8 * hash1(k + 1), 0.4 * (hash1(k + 2) - 0.5), 0.04);
  for (let k = 0; k < 40; k++) reed(2.0 + k * 0.5 + 0.3 * hash1(k + 9), -4.6, 1.2 + 1.6 * hash1(k + 3), 0.5 * (hash1(k + 4) - 0.5), 0.1);
  // Guntramin harppupuu
  const tree = group(scene, { x: -6.5, y: 0, z: -0.6 });
  const trunkPts = []; for (let i = 0; i <= 20; i++) { const u = i / 20; trunkPts.push([-0.6 * Math.sin(u * 2.4) + 0.3 * u, u * 6.4]); }
  flat(tree, strokeGeo(trunkPts, (u) => 0.55 - 0.3 * u), ink(C.black), {});
  const neckPts = []; for (let i = 0; i <= 24; i++) { const u = i / 24; neckPts.push([-0.4 + 4.8 * u, 6.3 + 0.9 * Math.sin(u * Math.PI) - 1.6 * u + 0.4 * Math.sin(u * Math.PI * 2)]); }
  flat(tree, strokeGeo(neckPts, (u) => 0.32 - 0.18 * u), ink(C.black), {});
  for (const s of deadTree(77, 0.9)) flat(tree, s, ink(C.black), { x: -0.3, y: 6.2, z: -0.01 });
  flat(tree, strokeGeo([[-0.2, 2.9], [0.8, 3.15], [2.0, 3.4], [3.4, 3.7]], (u) => 0.16 - 0.08 * u), ink(C.black), { z: 0.02 });
  const strings = [];
  for (let k = 0; k < 10; k++) {
    const u = 0.12 + k * 0.08;
    const top = neckPts[Math.round(u * 24)];
    const g = group(tree, { x: top[0], y: top[1], z: 0.01 });
    flat(g, rect(0.022, 1.2 + 0.5 * hash1(k), 0.5, 1), ink(C.paper, { shade: C.blue, raster: 0.45 }), {});
    strings.push({ g, k });
  }

  // --- muisto lammessa: aamun harjanne veden alla (peilikuva), ei kolmio eikä kartio ---
  // Heijastus riippuu kaukorannan viivasta (y 0.25) alaspäin: harjanteen huippu osoittaa alas, aurinko sen takana,
  // kahdeksan viiriä harjanteen alapuolella. Muoto = loc_valley.js:n tasanne ja rinteet (valleyRidge), x puristettuna.
  const MY = 0.25, MCX = 4.3, MSX = 0.17, MSY = 0.42, MH0 = 1.4;
  const mem = group(scene, { x: MCX, y: MY, z: PZ + 0.02 });
  const mtnMat = ink(C.paper, { shade: C.blue, raster: 0.88 });      // takimmaiset vuoret (loc_valley.js: mid/far ridgePts)
  const ridgeMat = ink(C.paper, { shade: C.blue, raster: 0.4 });     // pääharjanne (tasanne ja rinteet)
  const rimMat = ink(C.black, {});
  const sunMat = ink(C.red, { shade: C.black, raster: 0.25 });
  const flagMat = ink(C.red, { shade: C.paper, raster: 0.2 });
  const mastMat = ink(C.paper, { shade: C.blue, raster: 0.3 });
  const rPts = [];
  for (let x = -28; x <= 30.01; x += 0.5) rPts.push([x, Math.max(0.04, MH0 + valleyRidge(x))]);
  const mPts = ridgePts(-45, 45, 5.5, 11, { lambda: 11, n: 240, offset: MH0 * 0.9 });
  const sunG = group(mem, { x: 0.3, y: -1.9, z: -0.03 });
  flat(sunG, circle(1.25, 40), sunMat, {});
  const mtnG = group(mem, { z: -0.01 }); mtnG.scale.set(MSX, -MSY, 1);
  flat(mtnG, poly([[-45, 0], ...mPts, [45, 0]]), mtnMat, {});
  const ridgeG = group(mem, { z: 0.01 }); ridgeG.scale.set(MSX, -MSY, 1);
  flat(ridgeG, poly([[-28, 0], ...rPts, [30, 0]]), ridgeMat, {});
  flat(ridgeG, strokeGeo(rPts, 0.3), rimMat, { z: 0.01 });
  const flagXs = Array.from({ length: 8 }, (_, k) => -10.5 + k * 3.0);
  for (const x of flagXs) {
    const y = MH0 + valleyRidge(x);
    flat(ridgeG, rect(0.3, 2.4, 0.5, 0), mastMat, { x, y, z: 0.02 });
    flat(ridgeG, poly([[x, y + 2.4], [x - 4.6, y + 1.95], [x, y + 1.5]]), flagMat, { z: 0.03 });
  }
  const memMats = [mtnMat, ridgeMat, rimMat, sunMat, flagMat, mastMat];
  const setAppear = (mats, a) => { for (const m of mats) if (m.uniforms && m.uniforms.uAppear) m.uniforms.uAppear.value = a; };

  // --- ritari ---
  const L = leader(scene, {});
  const HX = -4.3;       // harppupuun juuri
  const HXS = -1.0;      // lammen ranta (polvistuminen)
  const HXT = -5.6;      // selkä puuhun (piiritys)
  const ridgeMates = Array.from({ length: 7 }, (_, i) => ({ P: knight(scene, { raster: 0.15 }), x: -1.5 + i * 2.3 }));

  // --- soitinolennot (critters.js) ---
  const Wc = common(S);
  const env = { lows: Wc.lows, brass: Wc.smooth((t) => clamp(S.energy.brass(t)), 0.5), fl: Wc.smooth((t) => clamp(S.fam.winds(t) * 1.3), 0.5) };
  const mosq = fluteMosquito(scene), duck = oboeDuck(scene), heron = cAnglaisHeron(scene);
  const snails = [tubaSnail(scene), tubaSnail(scene)];
  const frogs = [bassoonFrog(scene), bassoonFrog(scene)];
  const crows = [tromboneCrow(scene), tromboneCrow(scene), tromboneCrow(scene)];
  const mirror = knight(scene, { thin: true, body: C.black, limb: C.black, line: C.black, cape: C.black });   // Quijote-peili
  const mirrorLance = flat(scene, poly([[-0.03, 0], [0.03, 0], [0.03, 3.6], [-0.03, 3.6]]), ink(C.black), { z: PZ + 0.02 });
  const stab = flat(scene, poly([[0, 0], [0.12, 0.5], [0.5, 0.5], [0.2, 0.8], [0.34, 1.3], [0, 0.95], [-0.34, 1.3], [-0.2, 0.8], [-0.5, 0.5], [-0.12, 0.5]]), ink(C.black), { z: 0.9 });
  const stamp = flat(scene, poly([[-1.1, 0.1], [-0.7, 0.9], [-0.1, 0.6], [0.4, 1.1], [0.9, 0.5], [1.2, -0.2], [0.5, -0.7], [-0.4, -0.5], [-0.9, -0.6]]), ink(C.black), { z: 0.9 });
  const splash = flat(scene, poly([[-1.2, 0], [-0.9, 1.3], [-0.5, 0.4], [-0.2, 1.8], [0.1, 0.5], [0.5, 1.5], [0.8, 0.3], [1.2, 1.0], [1.2, 0]]), ink(C.paper), { x: 1.0, y: -1.5, z: PZ + 0.15 });
  // tipat: jokaisesta olennosta seitsemän mustaa pisaraa, kun veto pyyhkäisee ohi
  const dropMat = ink(C.black);
  const mkDrops = () => Array.from({ length: 7 }, (_, k) => ({ m: flat(scene, circle(0.1 + 0.05 * hash1(k + 3), 12), dropMat, { z: 0.6 }), vx: (hash1(k + 11) - 0.3) * 1.6, vy: 0.6 + hash1(k + 21) * 1.2 }));
  const CR = { mosq, duck, heron, sn0: snails[0], sn1: snails[1], fr0: frogs[0], fr1: frogs[1], cw0: crows[0], cw1: crows[1], cw2: crows[2] };
  const drops = Object.fromEntries(Object.keys(CR).map((k) => [k, mkDrops()]));

  // veto suon yli (wid_voitto): alkaa viirin kärjestä, päättyy suon oikeaan reunaan
  const sweep = brushStroke(scene, 90, C.red, { wmin: 0.12, wmax: 0.75, hairW: 0.06, fs: 2.4, bleed: 0.06, dryLen: 0.2, lambda: 0.012, seed: 5, z: 0.8 });
  // lautasten isku: yksi mustan musteen läiskä iskun ruudulla (kohtaloisku, koko z:stä)
  const spl = splat(scene, 1, { color: C.black, life: 1.2 });
  // englannintorven vääristys (tulkinta): haikara piirtää ritarin punaisen vedon mustina pisteinä
  const dotMat = ink(C.black);
  const dots = Array.from({ length: 14 }, () => flat(scene, circle(0.17, 14), dotMat, { z: 0.5 }));
  const hitAge = (ta, life) => (t) => { const x = t - (ta - S.LEAD); return x >= -1e-6 && x < life ? x : -1; };
  const hitStab = hitAge(tMos, 0.8), hitStamp = hitAge(tCrow, 1.6);

  // soitinten nuottialut: eleet seuraavat oman soittimen fraaseja (S.onsetsIn), lisäksi kanavan verhokäyrä
  const winOf = (...pairs) => ({ pairs, ons: pairs.flatMap(([a, b]) => S.onsetsIn(a, b)) });
  const pulseEnv = (list, t, att = 0.12, dec = 0.6) => { let m = 0; for (const o of list) { const u = t - o; const v = u < -att ? 0 : u < 0 ? ease((u + att) / att) : Math.exp(-u / dec); if (v > m) m = v; } return m; };
  const inWin = (w, t) => w.pairs.reduce((m, [a, b]) => Math.max(m, smoothstep(a - 0.3, a + 0.2, t) * (1 - smoothstep(b - 0.2, b + 0.8, t))), 0);
  const WIN = {
    mosq: winOf([tMos, tDuck], [tQ, tToad], [tRet, tR20]),
    duck: winOf([tDuck, tQ], [tCrick, tMock], [tRet, tR20]),
    heron: winOf([tQ, tToad], [tMock, tCrow], [tRet, tR20]),
    snail: winOf([tToad, tCrick], [tCrow, tChor], [tRet, tSnap]),
    frog: winOf([tMock, tCrow], [tR20, tSnap]),
    crow: winOf([tCrow, tAns], [tRet, tR20]),
  };
  const act = (w, t, fam) => clamp(Math.max(pulseEnv(w.ons, t), 0.5 * fam(t)) * inWin(w, t));
  const duty = (w, t) => 0.5 + 0.5 * Math.max(inWin(w, t), chor(t));   // vuorossa oleva täydessä värissä, muut rasterina
  const chor = (t) => smoothstep(tChor - 0.5, tChor + 1, t) * (1 - smoothstep(tAns - 1, tAns + 2, t));   // kuoro: kaikki yhteen ääneen
  const G = {
    mosq: (t) => clamp(Math.max(act(WIN.mosq, t, env.fl), chor(t) * env.fl(t))),
    duck: (t) => clamp(Math.max(act(WIN.duck, t, env.fl), chor(t) * env.fl(t))),
    heron: (t) => clamp(Math.max(act(WIN.heron, t, env.fl), chor(t) * env.fl(t))),
    snail: (t) => clamp(Math.max(act(WIN.snail, t, (u) => env.lows(u) * 1.6), chor(t) * env.lows(t))),
    frog: (t) => clamp(Math.max(act(WIN.frog, t, (u) => env.lows(u) * 1.7), chor(t) * env.lows(t))),
    crow: (t) => clamp(Math.max(act(WIN.crow, t, (u) => env.brass(u) * 1.8), chor(t) * env.brass(t))),
  };

  const present = (ta, t) => clamp(smoothstep(ta - 0.5, ta + S.LEAD, t));
  const silent = (t) => smoothstep(tAns - 0.5, tAns + 3, t) * (1 - smoothstep(tRet - 0.5, tRet + 2, t));
  const nightAway = (t) => smoothstep(tNight, fr(tNight, W2, 0.3), t) * (1 - smoothstep(tRet - 0.5, tRet + S.LEAD, t));
  // veto: tippojen jälkeen olennot hajoavat (veto kulkee vasemmalta oikealle)
  const sw0 = tVoit - S.LEAD, sw1 = fr(tVoit, END, 0.55);
  const sweepP = (t) => clamp((t - sw0) / (sw1 - sw0));
  const sweepX = (t, x0) => mix(x0, 17, ease(sweepP(t)));
  const dissolve = (t, x) => smoothstep(x - 0.8, x + 1.2, sweepX(t, HX + 0.6)) * (t >= sw0 ? 1 : 0);
  const vis = (ta, t) => present(ta, t) * (1 - 0.85 * silent(t)) * (1 - nightAway(t));
  const visD = (ta, t, x) => vis(ta, t) * (1 - dissolve(t, x));

  // --- paikat: kaikki olennot ritarin lähellä (≤ 8 yksikköä), mittakaava ritariin (2,0) nähden ---
  const ST = { mosq: [HX + 1.7, 2.45], duck: [2.8, -2.0], heron: POSTS[0], mirror: [1.7, MY], snails: [[-1.3, 0.05], [-0.45, 0.05]], frogs: [[-3.05, 0.22], [-2.3, 0.2]], crows: [[-5.7, 3.85], [-4.6, 4.05], [-3.5, 4.25]] };
  // piiritys (wid_uusi_hyokkays): asemat kutistuvat ritarin ympärille
  const RING = { mosq: [HXT + 1.7, 2.9], duck: [-2.2, 0.35], heron: [-2.9, 0.1], snails: [[-3.4, 0.05], [-3.9, 0.05]], frogs: [[-3.0, 0.2], [-3.7, 0.2]], crows: [[-4.0, 3.5], [-3.1, 2.9], [-2.2, 3.5]] };
  const SC = { mosq: 0.34, duck: 1.15, heron: 0.72, snail: 0.46, frog: 0.65, crow: 0.62 };
  const ringK = (t) => ramp(tRet, fr(tRet, tR20, 0.8), t) * (1 - ramp(tSnap, tVoit, t));
  const P2 = (a, b, k) => [mix(a[0], b[0], k), mix(a[1], b[1], k)];

  // --- kamera: jokaisessa otossa ritari ja olento samassa rajauksessa ---
  const HF = Math.tan((20 * Math.PI) / 180);   // puolikorkeus / etäisyys, kun fov 40
  // frame(f, bot, d, hx): ritari (x = hx) on kuvan vaakaosuudella f, alareuna bot, etäisyys d
  const frame = (f, bot, d, drift = 0.5, dx = 0.5, dy = 0.4, hx = HX) => {
    const cx = hx + (0.5 - f) * 2 * d * HF * (16 / 9), cy = bot + d * HF;
    return camPath([{ pos: [cx + dx, cy + dy, d], look: [cx, cy, 0], fov: 40 }, { pos: [cx + dx * 0.5, cy + dy, d - drift], look: [cx, cy + 0.05, 0], fov: 40 }]);
  };
  const wide = frame(0.4, -1.4, 13.5, 1.2, -0.6, 0.3);
  const shots = [
    { name: '2.1a laskeutuu suolle', a: A, b: tMos - S.LEAD, cam: wide },
    { name: '2.1b pisto: hyttynen ja ritari', a: tMos - S.LEAD, b: tDuck - S.LEAD, cam: frame(0.62, -0.7, 5.6, 0.4, 0.5, 0.4) },
    { name: '2.2a sorsa (oboe)', a: tDuck - S.LEAD, b: tQ - S.LEAD, cam: frame(0.3, -2.3, 7.6, 0.5) },
    { name: '2.2b haikara (englannintorvi)', a: tQ - S.LEAD, b: tToad - S.LEAD, cam: frame(0.2, -3.0, 9.8, 0.6) },
    { name: '2.2c kotilot (Dehring)', a: tToad - S.LEAD, b: tCrick - S.LEAD, cam: frame(0.3, -0.9, 5.8, 0.5, 0.4, 0.4) },
    { name: '2.2d sorsa kiihtyy', a: tCrick - S.LEAD, b: tMock - S.LEAD, cam: frame(0.3, -2.3, 7.6, 0.5, -0.5, 0.5) },
    { name: '2.2e peili ja sammakot', a: tMock - S.LEAD, b: tCrow - S.LEAD, cam: frame(0.28, -2.6, 7.6, 0.5, 0.5, 0.5) },
    { name: '2.2f varikset harppupuussa', a: tCrow - S.LEAD, b: tChor - S.LEAD, cam: frame(0.4, -0.4, 7.6, 0.5, 0.6, 0.4) },
