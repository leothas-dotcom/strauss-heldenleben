        s.root.scale.set(-SC.snail, SC.snail, 1);
        s.pose(clamp(gs * (i ? 1.0 : 0.85)));
        dropsFor(i ? 'sn1' : 'sn0', pos[0], pos[1] + 0.4, dd);
      }); }
    // Quijote-peili: sankarin heijastus venyy laihaksi lammen pintaan (veden alla)
    { const q = smoothstep(tMock - 0.3, tMock + 0.8, t) * (1 - smoothstep(tCrow - 0.5, tCrow + 1.5, t)) * (1 - nightAway(t)) * (1 - dissolve(t, ST.mirror[0]));
      mirror.root.visible = q > 0.01; mirrorLance.visible = q > 0.01;
      setAppear(mirror.mats, q);
      mirror.root.position.set(ST.mirror[0], ST.mirror[1], PZ + 0.3);
      mirror.root.scale.set(-0.9, -1.35 * (1 + 0.3 * q), 1);
      mirrorLance.position.set(ST.mirror[0] - 0.9, ST.mirror[1], PZ + 0.3);
      mirrorLance.scale.y = -1;
      poseKnight(mirror, kmix(KP.sit, { ...KP.call, tilt: 1.2, aN: 2.2, eN: 0.2, lean: -0.3 }, 0.5 * gh * q), t, 0); }
    // fagottisammakot tukilla
    { frogs.forEach((f, i) => {
        const dd = dissolve(t, ST.frogs[i][0]), p = visD(tMock, t, ST.frogs[i][0]);
        const pos = P2(ST.frogs[i], RING.frogs[i], rg);
        f.root.visible = p > 0.01; setAppear(f.mats, p * (1 - dd) * duty(WIN.frog, t));
        f.root.position.set(pos[0], pos[1] - 0.3 * (1 - present(tMock, t)), 0.05);
        f.root.scale.set(i ? -SC.frog : SC.frog, SC.frog, 1);
        f.pose(clamp(gf));
        dropsFor(i ? 'fr1' : 'fr0', pos[0], pos[1] + 0.3, dd);
      }); }
    // pasuunavarikset laskeutuvat harppupuuhun; piirityksessä ritarin ympärille
    { const land = ease(smoothstep(tCrow - 1.0, tCrow - S.LEAD, t));
      crows.forEach((c, i) => {
        const dd = dissolve(t, ST.crows[i][0]), p = visD(tCrow, t, ST.crows[i][0]);
        const ang = t * 0.9 + i * 2.1;
        const pos = P2(ST.crows[i], RING.crows[i], rg);
        c.root.visible = p > 0.01 || (t > tCrow - 1.0 && t < tCrow); setAppear(c.mats, Math.max(p, land) * (1 - dd) * duty(WIN.crow, t));
        c.root.position.set(pos[0] + 6 * (1 - land) + 0.3 * Math.cos(ang) * rg, pos[1] + 3 * (1 - land) + 0.25 * Math.sin(ang) * rg, -0.5 + (rg > 0.1 ? 0.8 : 0));
        c.root.scale.set(SC.crow, SC.crow, 1);
        c.pose(clamp(gc));
        dropsFor('cw' + i, pos[0], pos[1], dd);
      });
      const hsd = hitStamp(t);
      stamp.visible = hsd >= 0;
      if (hsd >= 0) { stamp.position.set(-3.2, 5.0, 0.9); stamp.scale.setScalar(0.9 + 0.3 * Math.min(1, hsd / 0.1)); stamp.material.uniforms.uAppear.value = 1 - smoothstep(0.8, 1.6, hsd); } }
    // wid_voitto: leveä punainen veto viirin kärjestä suon yli
    { const sp = sweepP(t), show = t >= sw0 && t < END + 4;
      sweep.mesh.visible = show && sp > 0.02;
      if (sweep.mesh.visible) {
        // alku: viirin kärjen oikea rata pyyhkäisyn huippuun (tPk), sitten veto jatkuu suon yli oikeaan reunaan
        const tPk = fr(tVoit, END, 0.25), ARC = 12, NN = 40;
        const pk = L.tipAt(tPk);
        const pts = [];
        for (let k = 0; k < NN; k++) {
          if (k < ARC) { const q = L.tipAt(mix(sw0, tPk, k / (ARC - 1))); pts.push([q.x, q.y]); }
          else { const f = (k - ARC + 1) / (NN - ARC); pts.push([pk.x + (17 - pk.x) * f, mix(pk.y, 1.6, smoothstep(0, 0.4, f)) - 1.4 * Math.sin(f * 2.2) + 0.4 * Math.sin(f * 9)]); }
        }
        const vis = ease(sp);
        const n = Math.max(2, Math.round(vis * (NN - 1)) + 1);
        sweep.set(pts.slice(0, n), 0.85, 1);
      } }
    spl.set(t, [{ t: tSplash2, x: 0.4, y: -1.2, s: 3.0, z: 6, z0: PZ + 0.5 }], S.LEAD);
    { const q = smoothstep(tMock, fr(tMock, tCrow, 0.7), t) * (1 - smoothstep(fr(tMock, tCrow, 0.9), tCrow, t));
      const hp = heron.root.position, tip = L.tipAt(t);
      dots.forEach((d, k) => {
        const f = (k + 1) / dots.length * q;
        d.visible = q > 0.02 && k / dots.length < q;
        const ox = hp[0] === undefined ? hp.x : hp.x;
        d.position.set(ox - 0.9 - f * 4.0, hp.y + 1.4 + 0.5 * Math.sin(f * 9 + k) + 0.4 * f, 0.5);
        d.scale.setScalar(1.3 + 0.4 * Math.sin(k));
      });
      void tip; }
    // lautasten roiske lammessa: yhden elementin teko ruutua ennen ääntä
    { const best = t - (tSplash2 - S.LEAD);
      splash.visible = best >= -1e-6 && best < 0.7;
      splash.scale.set(1 + best * 1.5, clamp(1 - best / 0.7) * 1.6, 1);
      if (t > tSplash2 - S.LEAD && t - tSplash2 < 3 && rk < 16) pond.rings[rk++].set(1.0, -1.5, tSplash2, 1.8); }
    st.hs = hs; st.mf = mf; st.m = [m1, m2, m3]; st.murk = murk; st.rg = rg;
    const dim = 0.12 + 0.28 * night - 0.12 * snap + 0.14 * murk;
    return { dim: clamp(dim, 0, 0.7), wind: 0.3 };
  }
  // koko veto on ohittanut kaikki (sameus väistyy)
  function dissolveAll(t) { return dissolve(t, 3.0); }

  // opastarkistus: olennot, ritarin teko, lampi ja muisto, sameus
  const probe = (t) => {
    const hs = heroState(t);
    const tip = L.tipAt(t);
    const [m1, m2, m3] = memWave(t);
    const act = {
      mosq: vis(tMos, t) > 0.05 ? G.mosq(t) : 0, duck: vis(tDuck, t) > 0.05 ? G.duck(t) : 0, heron: vis(tQ, t) > 0.05 ? G.heron(t) : 0,
      snail: vis(tToad, t) > 0.05 ? G.snail(t) : 0, frog: vis(tMock, t) > 0.05 ? G.frog(t) : 0, crow: vis(tCrow, t) > 0.05 ? G.crow(t) : 0,
    };
    const hsd = hitStab(t), hst = hitStamp(t);
    return {
      mosq_ele: act.mosq, sorsa_ele: act.duck, haikara_ele: act.heron, kotilo_ele: act.snail, sammakko_ele: act.frog, varis_ele: act.crow,
      puupuhallin_olennot: Math.max(act.mosq, act.duck, act.heron, act.frog), vaski_olennot: Math.max(act.snail, act.crow),
      olennot: act.mosq + act.duck + act.heron + act.snail + act.frog + act.crow,
      olento_nakyy: [mosq.root, duck.root, heron.root, snails[0].root, frogs[0].root, crows[0].root].filter((o) => o.visible).length,
      pisto: hsd >= 0 ? 1 : 0, tahra: hst >= 0 ? 1 : 0,
      sorsa_nokka: act.duck, haikara_askel: clamp((t - tQ) / (tToad - tQ)) * (t < tToad ? 1 : 0) + (t >= tToad ? 1 : 0),
      peili: smoothstep(tMock - 0.3, tMock + 0.8, t) * (1 - smoothstep(tCrow - 0.5, tCrow + 1.5, t)),
      sameus: st.murk ?? 0, piiritys: ringK(t), viiri_tumma: st.dark ?? 0,
      viirikarki_y: tip ? tip.y : 0, viirikarki_x: tip ? tip.x : 0,
      viiri_leveys: hs.width,
      ritari_x: hs.x, ritari_suunta: hs.facing, ritari_tilt: hs.pose.tilt, ritari_lanceAng: hs.lanceAng ?? 0,
      ritari_kallistus: hs.pose.tilt, ritari_polvella: hs.pose.hN > 1.3 ? 1 : 0,
      muisto: Math.max(m1, 0) * (memFade(t)), muisto_aalto1: m1, muisto_aalto2: m2, muisto_aalto3: m3,
      heijastus_y: mem.visible ? MY : null, heijastus_veden_alla: mem.visible ? 1 : 0,
      toverit_n: ridgeMates.filter((m) => m.P.root.visible).length,
      roiske: (() => { const b = t - (tSplash2 - S.LEAD); return b >= -1e-6 && b < 0.7 ? 1 + b : 0; })(),
      veto: sweepP(t),
    };
  };
  return { scene, update, shots, probe };
}
